<UserControl x:Class="Dashboard_WPF.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Roles" FontSize="26" FontWeight="Bold" Foreground="#172554" Margin="0,0,0,6"/>
            <TextBlock Text="Manage staff roles." FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>
            <Border Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Add Role" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Role ID"/>
                    <TextBox x:Name="RoleIdTextBox" Height="34" Margin="0,6,0,12" Padding="8"/>
                    <TextBlock Text="Role Name"/>
                    <TextBox x:Name="RoleNameTextBox" Height="34" Margin="0,6,0,20" Padding="8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear" Width="100" Height="38" Margin="0,0,10,0" Click="ClearButton_Click"/>
                        <Button Content="Save Role" Width="130" Height="38" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="SaveButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Roles Table" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <DataGrid ItemsSource="{Binding Roles}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Role ID" Binding="{Binding RoleId}" Width="100"/>
                            <DataGridTextColumn Header="Role Name" Binding="{Binding RoleName}" Width="*"/>
                            <DataGridTemplateColumn Header="Actions" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Tag="{Binding}" Click="EditButton_Click" Margin="0,0,6,0" Padding="8,3"/>
                                            <Button Content="Delete" Tag="{Binding}" Click="DeleteButton_Click" Padding="8,3"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
