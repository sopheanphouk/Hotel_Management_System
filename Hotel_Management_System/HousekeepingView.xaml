<UserControl x:Class="Dashboard_WPF.HousekeepingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Housekeeping" FontSize="26" FontWeight="Bold" Foreground="#172554" Margin="0,0,0,6"/>
            <TextBlock Text="Manage room cleaning tasks and status." FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>
            <Border Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Add housekeeping task" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Set the room, assign staff, and list what needs doing." Foreground="#64748B" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Room Number"/>
                            <TextBox x:Name="RoomNumberTextBox" Height="34" Margin="0,6,0,0" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Room Type"/>
                            <ComboBox x:Name="RoomTypeComboBox" Height="34" Margin="0,6,0,0" Padding="8">
                                <ComboBoxItem Content="Deluxe"/>
                                <ComboBoxItem Content="Standard"/>
                                <ComboBoxItem Content="Suite"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Current Status"/>
                            <ComboBox x:Name="StatusComboBox" Height="34" Margin="0,6,0,0" Padding="8">
                                <ComboBoxItem Content="Dirty"/>
                                <ComboBoxItem Content="In Progress"/>
                                <ComboBoxItem Content="Clean"/>
                                <ComboBoxItem Content="Inspected"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Assignment" FontWeight="SemiBold"/>
                            <TextBlock Text="Assign to" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
                            <TextBox x:Name="AssignedStaffTextBox" Height="34" Margin="0,3,0,0" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Task type" FontSize="11" Foreground="#64748B"/>
                            <ComboBox x:Name="TaskTypeComboBox" Height="34" Margin="0,6,0,0" Padding="8">
                                <ComboBoxItem Content="Cleaning"/>
                                <ComboBoxItem Content="Inspection"/>
                                <ComboBoxItem Content="Maintenance"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Priority"/>
                            <ComboBox x:Name="PriorityComboBox" Height="34" Margin="0,6,0,0" Padding="8">
                                <ComboBoxItem Content="Normal"/>
                                <ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="Urgent"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Due date"/>
                            <DatePicker x:Name="DueDatePicker" Height="34" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Estimated minutes"/>
                            <TextBox x:Name="EstimatedMinutesTextBox" Height="34" Margin="0,6,0,0" Padding="8"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Due time" FontSize="11" Foreground="#64748B"/>
                    <TextBox x:Name="DueTimeTextBox" Height="34" Margin="0,6,0,12" Padding="8"/>
                    <TextBlock Text="Checklist" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border BorderBrush="#D9E1EC" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="ChangedBedLinenCheckBox" Grid.Row="0" Grid.Column="0" Content="Changed bed linen"/>
                            <CheckBox x:Name="CleanBathroomCheckBox" Grid.Row="0" Grid.Column="1" Content="Clean bathroom"/>
                            <CheckBox x:Name="VacuumFloorCheckBox" Grid.Row="1" Grid.Column="0" Content="Vacuum floor"/>
                            <CheckBox x:Name="RestockMinibarCheckBox" Grid.Row="1" Grid.Column="1" Content="Restock minibar"/>
                            <CheckBox x:Name="ReplaceTowelsCheckBox" Grid.Row="2" Grid.Column="0" Content="Replace towels"/>
                            <CheckBox x:Name="EmptyTrashCheckBox" Grid.Row="2" Grid.Column="1" Content="Empty trash"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Notes"/>
                    <TextBox x:Name="NotesTextBox" Height="60" Margin="0,6,0,20" Padding="8" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear" Width="100" Height="38" Margin="0,0,10,0" Click="ClearButton_Click"/>
                        <Button Content="Save Task" Width="130" Height="38" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="SaveButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Housekeeping Table" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <DataGrid ItemsSource="{Binding Tasks}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="160"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Room Number" Binding="{Binding RoomNumber}" Width="120"/>
                            <DataGridTextColumn Header="Assigned Staff" Binding="{Binding AssignedStaff}" Width="*"/>
                            <DataGridTextColumn Header="Room Type" Binding="{Binding RoomType}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                            <DataGridTextColumn Header="Task Type" Binding="{Binding TaskType}" Width="120"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=d}" Width="110"/>
                            <DataGridTextColumn Header="Checklist" Binding="{Binding Checklist}" Width="2*"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*"/>
                            <DataGridTemplateColumn Header="Actions" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Tag="{Binding}" Click="EditButton_Click" Margin="0,0,6,0" Padding="8,3"/>
                                            <Button Content="Delete" Tag="{Binding}" Click="DeleteButton_Click" Padding="8,3"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
