<UserControl x:Class="Dashboard_WPF.HousekeepingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Housekeeping Tasks" FontSize="26" FontWeight="Bold" Foreground="#172554" Margin="0,0,0,6"/>
            <TextBlock Text="Manage housekeeping task records." FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>
            <Border Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Add Housekeeping Task" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Room ID"/><TextBox x:Name="RoomIdTextBox" Height="34" Margin="0,6,0,12" Padding="8"/>
                    <TextBlock Text="Task Type"/><ComboBox x:Name="TaskTypeComboBox" Height="34" Margin="0,6,0,12" Padding="8"><ComboBoxItem Content="Cleaning"/><ComboBoxItem Content="Inspection"/><ComboBoxItem Content="Maintenance"/></ComboBox>
                    <TextBlock Text="Status"/><ComboBox x:Name="StatusComboBox" Height="34" Margin="0,6,0,12" Padding="8"><ComboBoxItem Content="Pending"/><ComboBoxItem Content="In Progress"/><ComboBoxItem Content="Completed"/></ComboBox>
                    <TextBlock Text="Assigned To"/><TextBox x:Name="AssignedToTextBox" Height="34" Margin="0,6,0,12" Padding="8"/>
                    <TextBlock Text="Created At"/><DatePicker x:Name="CreatedAtPicker" Height="34" Margin="0,6,0,12"/>
                    <TextBlock Text="Completed At"/><DatePicker x:Name="CompletedAtPicker" Height="34" Margin="0,6,0,12"/>
                    <TextBlock Text="Notes"/><TextBox x:Name="NotesTextBox" Height="70" Margin="0,6,0,20" Padding="8" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Clear" Width="100" Height="38" Margin="0,0,10,0" Click="ClearButton_Click"/><Button Content="Save Task" Width="130" Height="38" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="SaveButton_Click"/></StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Housekeeping Tasks Table" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <DataGrid ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="160" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Task ID" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="Room ID" Binding="{Binding RoomId}" Width="80"/><DataGridTextColumn Header="Task Type" Binding="{Binding TaskType}" Width="120"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Assigned To" Binding="{Binding AssignedTo}" Width="110"/><DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat=d}" Width="110"/><DataGridTextColumn Header="Completed At" Binding="{Binding CompletedAt, StringFormat=d}" Width="110"/><DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                            <DataGridTemplateColumn Header="Actions" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Edit" Tag="{Binding}" Click="EditButton_Click" Margin="0,0,6,0" Padding="8,3"/><Button Content="Delete" Tag="{Binding}" Click="DeleteButton_Click" Padding="8,3"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
