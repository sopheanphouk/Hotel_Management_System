<UserControl x:Class="Dashboard_WPF.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Staff" FontSize="26" FontWeight="Bold" Foreground="#172554" Margin="0,0,0,6"/>
            <TextBlock Text="Manage staff records and account status." FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>
            <Border Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Add Staff" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Full Name"/>
                    <TextBox x:Name="FullNameTextBox" Height="34" Margin="0,6,0,12" Padding="8"/>
                    <TextBlock Text="Username"/>
                    <TextBox x:Name="UsernameTextBox" Height="34" Margin="0,6,0,12" Padding="8"/>
                    <TextBlock Text="Password Hash"/>
                    <TextBox x:Name="PasswordHashTextBox" Height="34" Margin="0,6,0,12" Padding="8"/>
                    <TextBlock Text="Role ID"/>
                    <TextBox x:Name="RoleIdTextBox" Height="34" Margin="0,6,0,12" Padding="8"/>
                    <CheckBox x:Name="IsActiveCheckBox" Content="Is Active" IsChecked="True" Margin="0,0,0,12"/>
                    <TextBlock Text="Created At"/>
                    <DatePicker x:Name="CreatedAtPicker" Height="34" Margin="0,6,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear" Width="100" Height="38" Margin="0,0,10,0" Click="ClearButton_Click"/>
                        <Button Content="Save Staff" Width="130" Height="38" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="SaveButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Staff Table" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <DataGrid ItemsSource="{Binding StaffMembers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="160" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Staff ID" Binding="{Binding Id}" Width="70"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140"/>
                            <DataGridTextColumn Header="Password Hash" Binding="{Binding PasswordHash}" Width="160"/>
                            <DataGridTextColumn Header="Role ID" Binding="{Binding RoleId}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Is Active" Binding="{Binding IsActive}" Width="90"/>
                            <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat=d}" Width="110"/>
                            <DataGridTemplateColumn Header="Actions" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Tag="{Binding}" Click="EditButton_Click" Margin="0,0,6,0" Padding="8,3"/>
                                            <Button Content="Delete" Tag="{Binding}" Click="DeleteButton_Click" Padding="8,3"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
