<Window x:Class="Dashboard_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dashboard_WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Hotel Management System"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="560"
        Background="#F5F6FA"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <!-- Custom title bar with native resize and snap -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                             CornerRadius="0"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="6"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Colors -->
        <SolidColorBrush x:Key="AccentBrush" Color="#4F7CFF"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="#161B33"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1F3B"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8FA3"/>
        <SolidColorBrush x:Key="NavTextBrush" Color="#C9CEE8"/>
        <SolidColorBrush x:Key="NavHoverBrush" Color="#2A3462"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B"/>

        <LinearGradientBrush x:Key="SidebarBrush"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Offset="0" Color="#1E2749"/>
            <GradientStop Offset="1" Color="#12172E"/>
        </LinearGradientBrush>

        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- Title bar buttons -->
        <Style x:Key="TitleBarButtonStyle"
               TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg"
                                        Property="Background"
                                        Value="#2A3462"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button -->
        <Style x:Key="CloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg"
                                        Property="Background"
                                        Value="{StaticResource DangerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar navigation -->
        <Style x:Key="NavItemStyle"
               TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavGroup"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">

                            <Grid>
                                <Border x:Name="AccentBar"
                                        Width="4"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="2"
                                        Opacity="0"/>

                                <ContentPresenter Margin="16,0,8,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg"
                                        Property="Background"
                                        Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg"
                                        Property="Background"
                                        Value="{StaticResource NavHoverBrush}"/>
                                <Setter TargetName="AccentBar"
                                        Property="Opacity"
                                        Value="1"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar buttons -->
        <Style x:Key="NavButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter Margin="16,0,12,0"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg"
                                        Property="Background"
                                        Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main content card -->
        <Style x:Key="CardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      Direction="270"
                                      Opacity="0.08"
                                      ShadowDepth="4"
                                      Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Window border -->
    <Border BorderBrush="#DADFEE"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0"
                  Background="{StaticResource TitleBarBrush}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="White"
                           Text="Hotel Management System"/>

                <!-- Title bar controls -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button x:Name="MinimizeButton"
                            Click="MinimizeButton_Click"
                            Content="&#xE921;"
                            Style="{StaticResource TitleBarButtonStyle}"/>

                    <Button x:Name="MaximizeButton"
                            Click="MaximizeButton_Click"
                            Content="&#xE922;"
                            Style="{StaticResource TitleBarButtonStyle}"/>

                    <Button x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Content="&#xE8BB;"
                            Style="{StaticResource CloseButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Main body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn"
                                      Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Grid Grid.Column="0"
                      Background="{StaticResource SidebarBrush}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Collapse sidebar -->
                    <Button x:Name="ToggleSidebarButton"
                            Grid.Row="0"
                            Width="40"
                            Height="40"
                            Margin="8,10,0,0"
                            HorizontalAlignment="Left"
                            Click="ToggleSidebarButton_Click"
                            Content="&#xE700;"
                            FontFamily="{StaticResource IconFont}"
                            FontSize="16"
                            Foreground="White"
                            Style="{StaticResource NavButtonStyle}"/>

                    <!-- User profile -->
                    <StackPanel Grid.Row="1"
                                Margin="0,10,0,16"
                                HorizontalAlignment="Center">

                        <Border Width="64"
                                Height="64"
                                Background="#2A3462"
                                CornerRadius="32">

                            <TextBlock FontFamily="{StaticResource IconFont}"
                                       FontSize="28"
                                       Foreground="White"
                                       Text="&#xE77B;"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="UserNameText"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="Jane Doe"/>

                        <TextBlock x:Name="UserRoleText"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource NavTextBrush}"
                                   Text="Administrator"/>
                    </StackPanel>

                    <!-- Scrollable hotel navigation -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <RadioButton Content="Dashboard"
                                         Tag="Dashboard"
                                         IsChecked="True"
                                         Checked="NavItem_Checked"
                                         Style="{StaticResource NavItemStyle}"/>

                            <RadioButton Content="Room Types"
                                         Tag="Room Types"
                                         Checked="NavItem_Checked"
                                         Style="{StaticResource NavItemStyle}"/>

                            <RadioButton Content="Rooms"
                                         Tag="Rooms"
                                         Checked="NavItem_Checked"
                                         Style="{StaticResource NavItemStyle}"/>

                            <RadioButton Content="Guests"
                                         Tag="Guests"
                                         Checked="NavItem_Checked"
                                         Style="{StaticResource NavItemStyle}"/>

                            <RadioButton Content="Reservations"
                                         Tag="Reservations"
                                         Checked="NavItem_Checked"
                                         Style="{StaticResource NavItemStyle}"/>

                            <RadioButton Content="Bookings"
                                         Tag="Bookings"
                                         Checked="NavItem_Checked"
                                         Style="{StaticResource NavItemStyle}"/>

                            <RadioButton Content="Invoices"
                                         Tag="Invoices"
                                         Checked="NavItem_Checked"
                                         Style="{StaticResource NavItemStyle}"/>

                            <RadioButton Content="Payments"
                                         Tag="Payments"
                                         Checked="NavItem_Checked"
                                         Style="{StaticResource NavItemStyle}"/>

                            <RadioButton Content="Housekeeping"
                                         Tag="Housekeeping"
                                         Checked="NavItem_Checked"
                                         Style="{StaticResource NavItemStyle}"/>

                            <RadioButton Content="Staff"
                                         Tag="Staff"
                                         Checked="NavItem_Checked"
                                         Style="{StaticResource NavItemStyle}"/>

                            <RadioButton Content="Roles"
                                         Tag="Roles"
                                         Checked="NavItem_Checked"
                                         Style="{StaticResource NavItemStyle}"/>

                            <Separator Margin="16,12"
                                       Background="#2A3462"/>

                            <Button x:Name="SignOutButton"
                                    Click="SignOutButton_Click"
                                    Style="{StaticResource NavButtonStyle}">

                                <TextBlock Text="Sign Out"
                                           Foreground="{StaticResource DangerBrush}"/>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Main content area -->
                <Grid Grid.Column="1"
                      Margin="24">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Page heading -->
                    <StackPanel Grid.Row="0">

                        <TextBlock x:Name="PageTitleText"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Hotel Dashboard"/>

                        <TextBlock x:Name="PageSubtitleText"
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Overview of hotel operations"/>
                    </StackPanel>

                    <!-- Dynamic module content -->
                    <Border Grid.Row="2"
                            Style="{StaticResource CardStyle}">

                        <ContentControl x:Name="PageContent"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"/>
                    </Border>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
