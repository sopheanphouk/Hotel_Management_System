<UserControl x:Class="Dashboard_WPF.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Border Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="New Down Payment" FontSize="24" FontWeight="SemiBold" Foreground="#172554"/>
                    <TextBlock Text="Record a payment against an invoice." Foreground="#64748B" Margin="0,5,0,20"/>
                    <TextBlock Text="Invoice ID"/><TextBox x:Name="InvoiceIdTextBox" Height="36" Margin="0,6,0,12" Padding="8"/>
                    <TextBlock Text="Amount"/><TextBox x:Name="AmountTextBox" Height="36" Margin="0,6,0,12" Padding="8"/>
                    <TextBlock Text="Payment Method"/>
                    <ComboBox x:Name="PaymentMethodComboBox" Height="36" Margin="0,6,0,12" Padding="8"><ComboBoxItem Content="Cash"/><ComboBoxItem Content="Credit Card"/><ComboBoxItem Content="Bank Transfer"/><ComboBoxItem Content="QR Pay"/></ComboBox>
                    <TextBlock Text="Paid At"/><DatePicker x:Name="PaidAtPicker" Height="36" Margin="0,6,0,12"/>
                    <TextBlock Text="Received By"/><TextBox x:Name="ReceivedByTextBox" Height="36" Margin="0,6,0,20" Padding="8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="100" Height="38" Margin="0,0,10,0" Click="ClearButton_Click"/><Button Content="Save payment" Width="160" Height="38" Background="#4059E8" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="SaveButton_Click"/></StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,20,0,0"><StackPanel><TextBlock Text="Receipt" FontSize="20" FontWeight="SemiBold" Foreground="#172554" Margin="0,0,0,18"/><TextBlock Text="Invoice ID" Foreground="#52658A"/><TextBlock x:Name="ReceiptInvoiceIdText" Text="[Invoice ID]" Margin="0,2,0,12"/><TextBlock Text="Amount" Foreground="#52658A"/><TextBlock x:Name="ReceiptAmountText" Text="0.00" Margin="0,2,0,12"/><TextBlock Text="Payment method" Foreground="#52658A"/><TextBlock x:Name="ReceiptMethodText" Text="[Payment method]" Margin="0,2,0,12"/><Separator/><TextBlock Text="Paid at" Foreground="#52658A" Margin="0,12,0,0"/><TextBlock x:Name="ReceiptPaidAtText" Text="[Paid date]" Margin="0,2,0,12"/><TextBlock Text="A receipt can be printed after the payment is saved." TextWrapping="Wrap" Background="#EEF1FF" Padding="12" Foreground="#52658A" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,20,0,0"><StackPanel><TextBlock Text="Payments Table" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="160"><DataGrid.Columns><DataGridTextColumn Header="Payment ID" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="Invoice ID" Binding="{Binding InvoiceId}" Width="90"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="100"/><DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="120"/><DataGridTextColumn Header="Paid At" Binding="{Binding PaidAt, StringFormat=d}" Width="110"/><DataGridTextColumn Header="Received By" Binding="{Binding ReceivedBy}" Width="110"/><DataGridTemplateColumn Header="Actions" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Edit" Tag="{Binding}" Click="EditButton_Click" Margin="0,0,6,0" Padding="8,3"/><Button Content="Delete" Tag="{Binding}" Click="DeleteButton_Click" Padding="8,3"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
